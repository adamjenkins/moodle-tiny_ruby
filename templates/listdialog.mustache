{{!
    @template tiny_ruby/listdialog

    The Furigana word list dialog: the text's ruby as a filter_ruby word list, to copy.

    Data attributes required for JS:
    * data-region="list", data-region="message"
    * data-action="copy", data-action="cancel"

    Context variables required for this template:
    * elementid - unique id prefix for the fields
    * hasentries - whether any ruby was found
    * text - the word list
    * summary - the counts, as a sentence
    * wordlisturl - the course word-list settings URL, or empty for no link

    Example context (json):
    {
        "elementid": "id_introeditor_tiny_ruby",
        "hasentries": true,
        "text": "# Page content, 2026-09-26\n漢字=かんじ",
        "summary": "Entries: 1. Conflicts: 0. Skipped: 0.",
        "wordlisturl": "https://example.com/filter/manage.php?contextid=2&filter=ruby"
    }
}}
{{< core/modal }}
    {{$title}}{{#str}} listbuttontitle, tiny_ruby {{/str}}{{/title}}
    {{$body}}
        {{#hasentries}}
            <p>{{#str}} listintro, tiny_ruby {{/str}}</p>
            <p>{{summary}}</p>
            <label for="{{elementid}}_list">{{#str}} listlabel, tiny_ruby {{/str}}</label>
            <textarea class="form-control" id="{{elementid}}_list" data-region="list" rows="12"
                spellcheck="false" lang="ja">{{text}}</textarea>
            <div class="mt-2" data-region="message" aria-live="polite"></div>
        {{/hasentries}}
        {{^hasentries}}
            <p>{{#str}} listempty, tiny_ruby {{/str}}</p>
        {{/hasentries}}
        {{#wordlisturl}}
            <p class="mt-3 mb-0"><a href="{{wordlisturl}}" target="_blank" rel="noopener">{{#str}} openwordlist, tiny_ruby {{/str}}</a></p>
        {{/wordlisturl}}
    {{/body}}
    {{$footer}}
        <button type="button" class="btn btn-secondary" data-action="cancel">{{#str}} closebuttontitle, core {{/str}}</button>
        <button type="button" class="btn btn-primary" data-action="copy" {{^hasentries}}disabled{{/hasentries}}>{{#str}} copy, tiny_ruby {{/str}}</button>
    {{/footer}}
{{/ core/modal }}
